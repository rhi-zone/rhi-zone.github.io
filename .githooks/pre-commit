#!/usr/bin/env bash
set -e

# --- private-name guard (generic; names live machine-local, never committed) ---
# Denylist: one pattern per line, blank/`#` lines ignored. Located under .git/
# so it is structurally uncommittable. Absent -> skip (operator opted out).
denylist="$(git rev-parse --git-dir)/info/private-names"
if [ -f "$denylist" ]; then
  staged_blocked=0
  # Staged files, NUL-delimited (handles spaces/newlines), added/copied/modified only.
  while IFS= read -r -d '' file; do
    # Skip binary files: git numstat marks them "-\t-\t".
    if git diff --cached --numstat -- "$file" | grep -q '^-	-	'; then
      continue
    fi
    staged_content="$(git show ":$file" 2>/dev/null || true)"
    [ -n "$staged_content" ] || continue
    while IFS= read -r pattern; do
      case "$pattern" in
        ''|\#*) continue ;;
      esac
      if printf '%s' "$staged_content" | grep -iqF -- "$pattern"; then
        echo "BLOCKED: staged file '$file' matches a private-name pattern: $pattern" >&2
        staged_blocked=1
      fi
    done < "$denylist"
  done < <(git diff --cached --name-only -z --diff-filter=ACM)
  if [ "$staged_blocked" -ne 0 ]; then
    echo "Commit aborted: remove the private name(s) from staged content." >&2
    echo "(Denylist: $denylist — machine-local, never commit it.)" >&2
    exit 1
  fi
else
  echo "Note: no private-name denylist at $denylist — skipping private-name guard." >&2
fi

# --- VitePress build ---
echo "Running VitePress build..."
cd docs && bun run build

echo "Pre-commit checks passed!"
